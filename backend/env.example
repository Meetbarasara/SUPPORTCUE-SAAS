# ============================================================
# AI-Powered Customer Support Platform — Backend Environment
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# ---- Server ----
PORT=5000
NODE_ENV=development  # "production" | "development"

# ---- Database ----
# MongoDB Atlas connection string (get from Atlas dashboard > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/support_platform?retryWrites=true&w=majority

# ---- Auth ----
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Widget session token secret (can be same as JWT_SECRET or different)
WIDGET_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# ---- AI (Google Gemini) ----
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ---- CORS / URLs ----
# Comma-separated list of allowed origins for the main dashboard
# e.g., https://yourdashboard.com,https://www.yourdashboard.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Your frontend URL (used in invitation emails, etc.)
FRONTEND_URL=http://localhost:5173
