# ============================================================
# AI-Powered Customer Support Platform — Backend Environment
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# ---- Server ----
PORT=5000
NODE_ENV=development  # "production" | "development"

# ---- Database ----
# MongoDB Atlas connection string (get from Atlas dashboard > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/support_platform?retryWrites=true&w=majority

# ---- Auth ----
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Widget session token secret (can be same as JWT_SECRET or different)
WIDGET_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# ---- AI (Google Gemini) ----
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ---- CORS / URLs ----
# Comma-separated list of allowed origins for the main dashboard
# e.g., https://yourdashboard.com,https://www.yourdashboard.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Your frontend URL (used in invitation emails, etc.)
# The Vite dev server runs on port 3000 — see frontend/vite.config.js
FRONTEND_URL=http://localhost:3000

# ---- Email (optional) ----
# Gmail SMTP credentials for company invitation emails. If unset, emails are
# skipped — the invitation URL is still returned by POST /api/company and
# logged to the server console, so onboarding works without SMTP.
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password

# ---- Seeding (not read by the server) ----
# Used only by `npm run seed:superuser` and `npm run reset:superuser`.
# Set these when you run those scripts; they are not needed at runtime.
# SUPERUSER_NAME=Super Admin
# SUPERUSER_EMAIL=you@example.com
# SUPERUSER_PASSWORD=at-least-12-characters

# ---- Production notes ----
# In production, the server EXITS if MONGO_URI, JWT_SECRET, or WIDGET_SECRET
# is missing — it will not fall back to the insecure development defaults.
#
# On a 512 MB host, cap V8's heap so the container does not OOM-kill Node:
#   NODE_OPTIONS=--max-old-space-size=400
