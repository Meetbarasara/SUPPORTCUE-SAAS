# Dependencies
node_modules/

# Environment files — NEVER commit these, they contain secrets.
# Broad pattern so backups/variants (.env.backup, .env.old) can't slip through.
.env
.env.*
!.env.example

# Build output
dist/
build/

# Uploaded files (temporary PDF storage)
backend/uploads/*
!backend/uploads/.gitkeep

# Deployment guides (local reference only)
AWS_DEPLOYMENT_GUIDE.md
deployment_guide.md

# Test files
embed-test.html

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories
.vscode/
.idea/

# Coverage
coverage/

# Misc
*.pem
*.ppk
